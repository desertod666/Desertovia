{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/react"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "e2e/world-harness.tsx", "e2e/farm-harness.tsx", "e2e/reconnect-harness.tsx", "e2e/harness.tsx", "e2e/chat-harness.tsx", "e2e/hospital-harness.tsx", "e2e/cooperative-harness.tsx", "e2e/patients-harness.tsx", "e2e/raid-timing-harness.tsx", "e2e/almighty-harness.tsx", "e2e/economy-harness.tsx", "e2e/notification-harness.tsx", "e2e/mobile-menu-harness.tsx", "e2e/live-combat-harness.tsx", "e2e/post-071-harness.tsx", "e2e/player-feedback-harness.tsx", "e2e/sound-harness.tsx", "e2e/dungeon-corpse-harness.tsx"]
}
