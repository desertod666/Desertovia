{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"],
  "exclude": ["e2e/world-harness.tsx", "e2e/farm-harness.tsx", "e2e/reconnect-harness.tsx", "e2e/progression-harness.tsx", "e2e/fences-harness.tsx", "e2e/raid-editor-harness.tsx", "e2e/rescue-harness.tsx", "e2e/owner-controls-harness.tsx","e2e/harness.tsx", "e2e/chat-harness.tsx", "e2e/hospital-harness.tsx", "e2e/cooperative-harness.tsx", "e2e/patients-harness.tsx", "e2e/raid-timing-harness.tsx", "e2e/almighty-harness.tsx", "e2e/economy-harness.tsx", "e2e/mobile-menu-harness.tsx", "e2e/live-combat-harness.tsx", "e2e/post-071-harness.tsx", "e2e/player-feedback-harness.tsx", "e2e/sound-harness.tsx", "e2e/dungeon-corpse-harness.tsx"]
}
